{
  "info": {
    "name": "Tech Challenge - Lambda Auth",
    "description": "Autenticação por CPF. Define a variável baseUrl com a URL do API Gateway (ou do Mock Lambda Test Tool). O header X-Correlation-ID é propagado para os logs JSON da função.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://<api-gateway-id>.execute-api.us-east-1.amazonaws.com",
      "type": "string"
    },
    {
      "key": "cpf",
      "value": "529.982.247-25",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "200 - CPF valido e cliente ativo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status 200', () => pm.response.to.have.status(200));",
              "pm.test('devolve X-Correlation-ID', () => pm.expect(pm.response.headers.has('X-Correlation-ID')).to.be.true);",
              "const body = pm.response.json();",
              "pm.test('token Bearer', () => pm.expect(body.token_type).to.eql('Bearer'));",
              "pm.collectionVariables.set('access_token', body.access_token);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"cpf\": \"{{cpf}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "token"]
        }
      }
    },
    {
      "name": "400 - CPF invalido",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"cpf\": \"00000000000\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "token"]
        }
      }
    },
    {
      "name": "400 - Body vazio",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status 400', () => pm.response.to.have.status(400));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "" },
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "token"]
        }
      }
    },
    {
      "name": "401 - Cliente inexistente ou inativo",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status 401', () => pm.response.to.have.status(401));"]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Correlation-ID", "value": "{{$guid}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"cpf\": \"111.444.777-35\"\n}" },
        "url": {
          "raw": "{{baseUrl}}/auth/token",
          "host": ["{{baseUrl}}"],
          "path": ["auth", "token"]
        }
      }
    }
  ]
}
