# Copie para terraform.tfvars e preencha. terraform.tfvars esta no .gitignore.
# Valores sensiveis tambem podem ser passados por TF_VAR_<nome>.

project_name = "techchallenge"
environment  = "prod"
aws_region   = "sa-east-1"

# Gerado por: dotnet lambda package --output-package lambda-auth.zip
package_path = "../lambda-auth.zip"

# Rede — outputs do repositorio soat-infra
# vpc_id     = "vpc-xxxxxxxx"
# subnet_ids = ["subnet-xxxxxxxx", "subnet-yyyyyyyy"]

# Segredos — NAO commite valores reais
# db_connection_string = "Host=<rds-endpoint>;Port=5432;Database=techchallengedb;Username=postgres;Password=<senha>"
# jwt_secret           = "<chave-de-no-minimo-32-caracteres>"

jwt_issuer             = "fiap-tech-challenge"
jwt_audience           = "fiap-api"
jwt_expires_in_seconds = 3600
